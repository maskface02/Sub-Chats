# Database
# Dev: leave unset → pglite in-process (in-memory)
# Dev with file: PGLITE_DATA_DIR=./.pglite  →  pglite on disk
# Prod: real Postgres URL (e.g. Vercel Postgres)
# DATABASE_URL="postgres://user:pass@host:5432/dbname"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# AI provider keys (add at least one)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Sentry (optional, for production)
SENTRY_DSN=""

# Logging
LOG_LEVEL="info"
