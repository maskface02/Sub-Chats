# Database
# Dev: leave unset → pglite in-process (in-memory)
# Dev with file: PGLITE_DATA_DIR=./.pglite  →  pglite on disk
# Prod: real Postgres URL (e.g. Vercel Postgres)
# DATABASE_URL="postgres://user:pass@host:5432/dbname"

# Auth.js
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="http://localhost:3000"

# AI provider keys (optional — users can add their own via Provider settings)
# Fallback chain order: OPENAI → ANTHROPIC → Ollama → none
OPENAI_API_KEY=""
# Anthropic key is now wired: third in the env fallback chain (default model claude-3-5-haiku-latest)
ANTHROPIC_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Provider key encryption (recommended in prod; dev derives from AUTH_SECRET)
# Generate: openssl rand -base64 32
# ENCRYPTION_KEY=""

# Sentry (optional, for production)
SENTRY_DSN=""

# Logging
LOG_LEVEL="info"

# Direct access (no login): synthetic guest session for every request.
# Local/self-hosted convenience — leave unset for real accounts.
# ALLOW_GUEST_ACCESS="true"

# Sub-chat context note template (used when AI is called in a sub-chat)
# Override to customize how the model understands the sub-chat context.
# Placeholders: {parentTitle}, {highlightText}
# SUBSCHAT_SYSTEM_PROMPT="You are answering a follow-up question in a sub-chat. The user branched from {parentTitle} at the phrase: \"{highlightText}\". The following conversation history provides context; respond to the latest user message."
